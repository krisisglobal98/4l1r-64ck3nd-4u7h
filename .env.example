PORT=8083
DATABASE_URL=postgres://USER@localhost:5432/alir_auth_db?sslmode=disable
TEST_DATABASE_URL=postgres://USER@localhost:5432/alir_auth_db_test?sslmode=disable
LOG_LEVEL=info
# iss of the access tokens; Portal Master checks it (PM_AUTH_ISSUER)
AUTH_ISSUER=alir-auth
AUTH_ACCESS_TTL_MINUTES=15
# false only for local HTTP development (the refresh cookie is Secure otherwise)
AUTH_COOKIE_SECURE=true
# Path of the refresh cookie as the browser sees the sign-in endpoints (behind the /auth-api proxy: /auth-api/auth)
AUTH_COOKIE_PATH=/auth
# Portal Master service (organisation tree for user scopes)
PM_SERVICE_URL=http://localhost:8081
# First administrator, made once when there is no account; must change the password at the first sign-in
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=

# Mail (forgot password, reset links, account notices) to the email of the account's employee (Portal Master →
# Karyawan). Empty SMTP_HOST: mail waits in auth.mail_outbox. SMTP_TLS: starttls (587) | tls (465) | none (local only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="ALIR <no-reply@perusahaan.co.id>"
SMTP_TLS=starttls
# Development and test installations: mail goes ONLY to these addresses ("a@b.co") or domains ("@b.co"), comma-
# separated; any other address is held (status failed, never sent). Leave empty in production.
SMTP_ALLOW_ONLY=
# Address of the ALIR pages, for the links in mail
APP_BASE_URL=http://localhost:5173
# OpenID Connect: the issuer must be the public URL of this service (the discovery document is under it); Portal
# Master's PM_AUTH_ISSUER must be the same. Behind the Vite dev proxy: http://localhost:5173/auth-api.
AUTH_PUBLIC_URL=https://auth.alir.example
# The single sign-on cookie's path as the browser sees the /oauth2 endpoints (behind a proxy prefix: /auth-api/oauth2).
AUTH_SSO_COOKIE_PATH=/oauth2
# Self sign-up: the terms accepted (version, page), the captcha of the public forms (none|turnstile|hcaptcha), and
# whether the client address comes from X-Forwarded-For (only behind a proxy that sets it).
AUTH_TERMS_VERSION=2026-11
AUTH_TERMS_URL=
AUTH_CAPTCHA_PROVIDER=none
AUTH_CAPTCHA_SECRET=
AUTH_CAPTCHA_SITE_KEY=
AUTH_TRUST_PROXY=false
# Seals secrets kept in the database (TOTP, identity provider client secrets): 32 bytes, base64 (openssl rand -base64 32).
# Keep it safe and the same across instances; losing it means members enrol MFA again and IdP secrets are re-entered.
AUTH_SECRET_KEY=
